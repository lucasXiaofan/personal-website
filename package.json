{
  "name": "xiaofan-personal-website",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/build-content.mjs --check",
    "build": "node scripts/build-content.mjs && hugo --gc --minify",
    "dev": "node scripts/build-content.mjs && hugo server --bind 127.0.0.1 --port 1313 --disableFastRender",
    "check": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
