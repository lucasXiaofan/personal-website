{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared Reusable and Journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "kind",
    "title",
    "date",
    "summary",
    "content",
    "attachments",
    "comments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "reusable",
        "journal"
      ]
    },
    "kind": {
      "enum": [
        "blog",
        "system",
        "tutorial",
        "project",
        "paper",
        "thought",
        "daily",
        "experiment"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "const": "content.md"
    },
    "draft": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "alt": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "audio",
              "video",
              "document"
            ]
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "threads"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "url"
            ],
            "properties": {
              "platform": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/[a-zA-Z0-9/_-]+/$"
      },
      "uniqueItems": true
    }
  }
}
